{
  "name": "hugo-grid-gallery",
  "version": "2.0.3",
  "description": "Collection-based image galleries for Hugo",
  "homepage": "https://github.com/cnichte/hugo-grid-gallery#readme",
  "bugs": {
    "url": "https://github.com/cnichte/hugo-grid-gallery/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnichte/hugo-grid-gallery.git"
  },
  "license": "ISC",
  "author": "",
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "hugo server --source exampleSite --themesDir ../.. --disableFastRender --noHTTPCache",
    "test": "sh tests/run-build-tests.sh",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "release:patch": "npm run test:all && npm version patch && git push origin main --follow-tags",
    "release:minor": "npm run test:all && npm version minor && git push origin main --follow-tags",
    "release:major": "npm run test:all && npm version major && git push origin main --follow-tags",
    "tree": "tree -a -L 5 ./assets",
    "vendor:fslightbox": "cp node_modules/fslightbox/index.js assets/ext/fslightbox/fslightbox.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.6.2",
    "cheerio": "^1.2.0",
    "fslightbox": "3.8.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
